# Copy to .env and fill in your own key. Never commit .env.
BAZE_API_KEY=
BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# Choose an exact model ID returned by: python -m scripts.check_baze
BAZE_MODEL=gpt-6-luna
# Optional settings:
CORS_ORIGINS=
GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb
# Optional local OCR settings (no AI API calls):
OCR_MODEL_DIR=./data/ocr_models
OCR_MIN_CONFIDENCE=0.65
